# ── Run mode ──────────────────────────────────────────────
# Optional profile selector: dev or prod uses config/dev.env or config/prod.env.
# Leave empty to continue using .env.local. CLI --env overrides this selector.
APP_ENV=
# test     = no Supabase needed. Data in .data/ (JSON file + uploads), local admin login + 2FA.
# supabase = use Supabase (fill in the keys below).
APP_MODE=test

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — NEVER expose this
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection URI (IPv4, port 5432), used by database maintenance scripts.
SUPABASE_DB_URL=
SUPABASE_DB_CA_CERT=

# Public site URL (used for SEO, sitemap and the links inside emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Random 32+ char string. Signs the local admin session (test mode) and the 2FA secrets.
APP_SECRET=change-me-to-a-long-random-string
CRON_SECRET=

# ── Email (the mail server lives here, not in the admin portal) ───────────────
# Leave SMTP_HOST empty to send no email. The admin portal (Settings > Email) only switches sending on or off,
# chooses who receives the alerts and whether customers get a confirmation.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL/TLS), false for 587 (STARTTLS). Empty = true only when the port is 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Maison Jawaher

# ── Analytics ─────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to switch analytics off (dev, staging).
GA_MEASUREMENT_ID=

# ── Admin portal address ──────────────────────────────────
# Private URL of the admin portal (the plain /admin does not exist). Lowercase letters, digits and hyphens, 4-40 characters.
# Use a different, hard-to-guess value per environment and keep it out of public pages.
NEXT_PUBLIC_ADMIN_PATH=/portal-x7k2m9
